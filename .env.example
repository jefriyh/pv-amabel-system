APP_NAME="Guestbook Komplek"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Di produksi WAJIB https:// — kamera HP hanya aktif pada secure context
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Port nginx di host
APP_PORT=8080

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=guestbook
DB_USERNAME=guestbook
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
# Port MySQL yang dibuka ke localhost host (untuk TablePlus/DBeaver)
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="guestbook@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Notifikasi Telegram
#--------------------------------------------------------------------------
# Panduan lengkap ada di README.md bagian "Setup Telegram".
# 1. Buat bot lewat @BotFather  -> dapat TELEGRAM_BOT_TOKEN
# 2. Masukkan bot ke grup, jadikan admin
# 3. Kirim pesan di grup, buka https://api.telegram.org/bot<TOKEN>/getUpdates
#    -> ambil chat.id (angkanya diawali tanda minus) untuk TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Isi hanya kalau grup memakai fitur Topics
TELEGRAM_THREAD_ID=

#--------------------------------------------------------------------------
# Privasi data tamu
#--------------------------------------------------------------------------
# Foto KTP & selfie dihapus otomatis setelah sekian hari (baris rekap tetap tersimpan)
GUESTBOOK_PHOTO_RETENTION_DAYS=90
